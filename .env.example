# Database
DATABASE_URL=postgresql://username:password@host:port/database

# JWT Secret
JWT_SECRET=your-secret-key-here

# Port
PORT=5000

# Cloudinary (for article image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ImageKit (fallback image storage -- used automatically when a Cloudinary
# upload fails, e.g. free-plan quota exceeded)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key

# Stripe (for music submission payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Email (for notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
OWNER_EMAIL=your_email@gmail.com

# Cloud808 (self-hosted MinIO -- see the sibling Cloud808 repo). Optional:
# when any of these are missing for a given site, uploadImage() skips
# Cloud808 entirely and behaves exactly as it did before this integration
# (Cloudinary -> ImageKit). Never point CLOUD808_ACCESS_KEY/SECRET_KEY at
# an AWS account -- these are MinIO credentials for our own server, and
# should be a scoped-down MinIO user (read+write on the two buckets only),
# not the MinIO root user.
# CLOUD808_ENDPOINT is the AUTHENTICATED S3 endpoint (storage.cry808.com),
# separate from the public read-only media.*.com hostnames used below for
# CLOUD808_*_PUBLIC_URL -- the media.*.com hostnames reject writes (403).
CLOUD808_ENDPOINT=https://storage.cry808.com
CLOUD808_ACCESS_KEY=your_minio_access_key
CLOUD808_SECRET_KEY=your_minio_secret_key
CLOUD808_CRY808_BUCKET=cry808
CLOUD808_2KOVERALLS_BUCKET=2koveralls
CLOUD808_CRY808_PUBLIC_URL=https://media.cry808.com
CLOUD808_2KOVERALLS_PUBLIC_URL=https://media.2koveralls.com

# Cloudflare (edge cache purge on article/featured mutations)
# One token + zone ID per publication -- a token scoped to one site's zone
# can never purge (or see) another site's cache. Add a new pair here (and
# in utils/cloudflarePurge.js's SITES map) when a new publication goes on
# Cloudflare.
CLOUDFLARE_CRY808_API_TOKEN=your_cry808_zone_scoped_cache_purge_token
CLOUDFLARE_CRY808_ZONE_ID=your_cry808_com_zone_id

# 2KOveralls isn't on Cloudflare yet -- leave unset until it is. The purge
# utility skips gracefully (logs + no-ops) when these are missing.
CLOUDFLARE_2KOVERALLS_API_TOKEN=your_2koveralls_zone_scoped_cache_purge_token
CLOUDFLARE_2KOVERALLS_ZONE_ID=your_2koveralls_com_zone_id
